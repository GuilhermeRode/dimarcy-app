{
  "name": "dimarcy-pedidos",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "app:dist": "vite build && electron-builder --win",
    "cap:sync:dev": "cp capacitor.config.dev.ts capacitor.config.ts && npx cap sync android",
    "cap:sync:prod": "git checkout capacitor.config.ts && npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "axios": "^1.7.9",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "react-simple-maps": "^5.0.5",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "br.com.dimarcy.pedidos",
    "productName": "Di Marcy Pedidos",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/logo-icon.png"
    },
    "nsis": {
      "createDesktopShortcut": "always"
    }
  }
}
