
DATABASE_URL=
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
TOKEN_EXPIRE_MINUTES=
# Liste as origens do app (web, Electron, Android) em vez de "*".
CORS_ORIGINS=*
# Liga /docs e /openapi.json (só em desenvolvimento).
ENABLE_DOCS=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Base URL of the frontend, used to build the "esqueci minha senha" reset link.
# Defaults to https://app.dimarcy.com.br — override for local dev (e.g. http://localhost:5173).
FRONTEND_URL=

# Notificações por e-mail (via Resend): ao criar, alterar e entregar um pedido,
# para dimarcypedidos@gmail.com, o vendedor e (em e-mail separado) o cliente.
# Deixe RESEND_API_KEY vazio para desativar.
# MAIL_FROM precisa estar em um domínio verificado no Resend — gmail.com não
# pode ser verificado, por isso as respostas são redirecionadas (Reply-To)
# para dimarcypedidos@gmail.com. Ex.: MAIL_FROM="Di Marcy Pedidos <pedidos@dimarcy.com.br>"
RESEND_API_KEY=
MAIL_FROM=
