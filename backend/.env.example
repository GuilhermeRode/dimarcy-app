# Em produção use PostgreSQL, ex.: postgresql://usuario:senha@host:5432/dimarcy
DATABASE_URL=sqlite:///./dimarcy.db
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=*
ADMIN_EMAIL=admin@dimarcy.com.br
ADMIN_PASSWORD=admin123

# Notificação por e-mail quando um pedido é marcado como entregue.
# Deixe SMTP_HOST vazio para desativar o envio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=
